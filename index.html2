<!DOCTYPE html>

<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Página Pessoal — Seu Nome</title>
  <!-- Salve o tema escolhido como "estilo.css" (mesma pasta deste arquivo) -->
  <link rel="stylesheet" href="estilo.css">
</head>

<body>
  <div class="pagina">

    <!-- ====== CABEÇALHO — TROQUE pelo seu nome e sua frase ====== -->
    <header class="cabecalho">
      <h1>Matheus Sebastian Vieira da Silva Santos</h1>
      <p>Estudante de Desevolvimento de Sistemas · IFAL</p>
      <nav>
        <a href="#sobre">Sobre</a>
        <a href="#projetos">Projetos</a>
        <a href="#contato">Contato</a>
      </nav>
    </header>

    <!-- ====== CONTEÚDO PRINCIPAL ====== -->
    <main class="principal">
      <section id="sobre" class="cartao">
        <h2>Sobre mim</h2>
        <!-- TROQUE por uma breve apresentação sua -->
        <p><i>Eu me Chamo Matheus Tenho 16 Anos,Não Gosto de Ler Livros Mas Gosto de Praticar Esportes Como Vôlei,Badminton Natação entre outros.Meus hobbies creio que seja jogar Jogos Eletronicos.E além de ser meus hobbies são os meus interesses também.</i></p>
      </section>

      <section id="projetos" class="cartao">
        <h2>Projetos</h2>
        <!-- Galeria com Grid: cada .projeto é um card; adicione/remova à vontade -->
        <div class="projetos">
          <article class="projeto">
            <h3>Projeto 1</h3>
            <p>O que é e o que você fez. TROQUE por um projeto seu.</p>
          </article>
          <article class="projeto">
            <h3>Projeto 2</h3>
            <p>Descrição curta do projeto.</p>
          </article>
          <article class="projeto">
            <h3>Projeto 3</h3>
            <p>Descrição curta do projeto.</p>
          </article>
        </div>
      </section>
    </main>

    <!-- ====== BARRA LATERAL ====== -->
    <aside class="lateral">
      <section class="cartao">
        <h2>Habilidades</h2>
        <!-- TROQUE pelas suas habilidades -->
        <ul class="habilidades">
          <li>HTML</li>
          <li>CSS</li>
          <li>Grid</li>
          <li>JavaScript</li>
        </ul>
      </section>

      <section id="contato" class="cartao">
        <h2>Contato</h2>
        <!-- TROQUE pelos seus links -->
        <ul class="contato">
          <li>✉️ <a href="msvss1@aluno.ifal.edu.br">msvss1@aluno.ifal.edu.br</a></li>
          <li>🐙 <a href="https://github.com/matheussebastian401-ops.github.io

            ">github.com/matheussebastian401-ops.github.io
</a></li>
        </ul>
      </section>
    </aside>

    <!-- ====== RODAPÉ — TROQUE o nome ====== -->
    <footer class="rodape">© 2026 Matheus Sebastian · feito com HTML + CSS Grid</footer>

  </div>
</body>

</html>
